# Required — leave as-is unless you want the SQLite file somewhere else
DATABASE_URL="file:./dev.db"

# Required
ANTHROPIC_API_KEY=

# Optional — override the default models
# CLAUDE_MODEL=claude-opus-5
# CLAUDE_FAST_MODEL=claude-haiku-4-5

# Optional — override per-million-token pricing used for spend tracking,
# if your actual negotiated/console rates differ from these defaults
# CLAUDE_MODEL_PRICE_IN_PER_MTOK=5
# CLAUDE_MODEL_PRICE_OUT_PER_MTOK=25
# CLAUDE_FAST_MODEL_PRICE_IN_PER_MTOK=1
# CLAUDE_FAST_MODEL_PRICE_OUT_PER_MTOK=5

# Optional — only needed for the vector-map feature (off by default, toggle
# in Admin). Get a key at https://www.voyageai.com/ — captured profile text
# is sent to Voyage only when this feature is both toggled on AND this is set.
# VOYAGE_API_KEY=
